# savestate's guest kernel options, applied after orbd's fragment by build.sh (and
# replacing any line of it that sets the same symbol). What savestate relies on,
# whether or not orbd's fragment already has it; build.sh fails if any of it does not
# survive.

CONFIG_LOCALVERSION="-savestate"

# New VM generation ID on every restore (`-device vmgenid`): the kernel reseeds its RNG.
CONFIG_ACPI=y
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
# The guest agent's channel to the host (`-device vhost-vsock-pci`).
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# Disk and network.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_EXT4_FS=y
# kvmclock: the guest clock that a restore resumes without adding host time.
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
# Free page reporting lets the host drop memory the guest freed (smaller memory files).
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
# /proc/sys/vm/compact_memory: the pre-checkpoint hook gathers freed memory into blocks
# large enough to report.
CONFIG_COMPACTION=y
# Serial console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
